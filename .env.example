# Puerto HTTP donde responderá el microservicio.
PORT=8080

# Datos de la base. Docker reemplaza DB_HOST por "db" dentro del contenedor.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=microservicio_incidencias
DB_USER=incidencias_user
DB_PASSWORD=cambiar_esta_clave

# En esta práctica local, Docker también utiliza DB_PASSWORD para root.
